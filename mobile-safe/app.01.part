  const screenElements = [
    ui.bootScreen,
    ui.titleScreen,
    ui.storyScreen,
    ui.choiceScreen,
    ui.interactionScreen,
    ui.cinematicScreen,
    ui.consequenceScreen,
    ui.endingScreen,
    ui.errorScreen,
  ];

  const diagnostics = [];
  let toastTimer = 0;
  let typewriterTimer = 0;
  let fullDialogueText = '';
  let dialogueTyping = false;
  let storagePersistent = false;
  let storageAvailable = false;
  let memoryStorage = new Map();
  let currentInteractionComplete = null;
  let currentInteractionFallback = null;
  let currentHoldCleanup = null;
  let data = null;
  let runtime = null;

  function clone(value) {
    if (typeof structuredClone === 'function') return structuredClone(value);
    return JSON.parse(JSON.stringify(value));
  }

  function log(message, detail) {
    const suffix = detail === undefined
      ? ''
      : ` ${typeof detail === 'string' ? detail : JSON.stringify(detail)}`;
    const line = `[${new Date().toISOString()}] ${message}${suffix}`;
    diagnostics.push(line);
    if (diagnostics.length > 180) diagnostics.shift();
    console.log(line);
  }

  function showScreen(target) {
    for (const screen of screenElements) {
      screen.hidden = screen !== target;
    }
  }

  function setBootProgress(percent, detail) {
    const value = Math.max(0, Math.min(100, Math.round(percent)));
    ui.bootProgress.style.width = `${value}%`;
    ui.bootPercent.textContent = `${value}%`;
    ui.bootDetail.textContent = detail;
    ui.bootProgressTrack?.setAttribute('aria-valuenow', String(value));
  }

  function showToast(message, duration = 1800) {
    clearTimeout(toastTimer);
    ui.toast.textContent = message;
    ui.toast.hidden = false;
    toastTimer = window.setTimeout(() => {
      ui.toast.hidden = true;
    }, duration);
  }

  function safeStorageGet(key) {
    if (storageAvailable) {
      try {
        return window.localStorage.getItem(key);
      } catch (error) {
        log('localStorage read failed', String(error));
        storageAvailable = false;
      }
    }
    return memoryStorage.get(key) ?? null;
  }

